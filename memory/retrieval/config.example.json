{
  "_comment": "示例：让检索指向项目本地的运行时记忆 store（而非 Obsidian）。grader 把每通对话的 issue 沉淀成 *.md 后，agent 启动前可 memory_search 拉相关历史教训。",
  "store_dir": "./memory/store",
  "db_path": "./memory/.memory_index.db",
  "steering": "只记会改变下次行为的教训：红线/规则入 org（人工评审），场景教训入 task。不记一次性事实、闲聊、可从代码推导的内容。入库前四维自评（独立完整/行为增量/复用面/边界清晰，各 0-25）：总分 <72 或任一维 <12 不写入，宁缺毋滥。",
  "read_only": false,
  "dedup_gate": true,
  "max_chars_per_memory": 6000,
  "max_total_recall_chars": 20000,
  "exclude_files": ["index.md", "log.md", "README.md"],
  "frontmatter_fields": {
    "title": "title",
    "summary": "summary",
    "tags": "tags",
    "type": "type",
    "updated": "updated",
    "created": "created",
    "provenance": "provenance",
    "confidence": "confidence"
  },
  "conf_penalty": 0.5,
  "fts_weights": {"title": 10.0, "summary": 6.0, "tags": 4.0, "body": 1.0},
  "like_weights": {"title": 3, "summary": 2, "tags": 2, "body": 1},
  "rrf_k": 60,
  "half_life_days": 30,
  "recency_boost": 0.5,
  "no_date_weight": 0.3,
  "output_format": "json"
}
